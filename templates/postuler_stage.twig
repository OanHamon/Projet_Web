{% extends 'base.twig' %}


{% block styles %}
    <link rel="stylesheet" href="/css/style_stage_page.css">
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/token.css">
{% endblock %}



{% block content %}
    <main>
      <div class="page-wrapper">

        <div class="col-left">
          <div class="block-content-stage card-main">

            <h1>Postuler à : {{offre.titre}}</h1>

            <p>Vous êtes sur le point de postuler à un stage. Veuillez remplir les informations ci-dessous pour finaliser votre candidature.</p>

            <h2>Formulaire de candidature</h2>

            <form class="application-form" id="application-form"  method="post" action="/candidater/{{offre.id_offre}}" enctype="multipart/form-data">
                <h4>Informations personnelles</h4>

                <label for="phone">Numéro de téléphone</label>
                <input type="tel" id="phone" name="phone">

                <h4>Ajoutez votre CV *</h4>
                <input type="file" id="cv" name="cv" accept=".pdf,.doc" required>

                <h4>Lettre de motivation *</h4>
                <input type="file" id="lm" name="lm"  accept=".pdf,.doc" required>

                <h4>Autres informations :</h4>
                <textarea id="message" name="message" rows="6" placeholder="Entrez votre texte..."></textarea>
            </form>


          </div>
        </div>

        <div class="col-right">

          <div class="block-content-stage card-entreprise">
            <h2>Résumé</h2>
            <p>{{offre.description_carte}}</p>
            <a href="/offre/{{offre.id_offre}}"><button class="btn-detail">Voir les détails</button></a>
          </div>

          <div class="block-content-stage card-competences">
            <h2>Compétences</h2>
            <p class="comp-intro">Les compétences spécifiques que nous recherchons pour ce stage.</p>

                <div class="comp-section">
                <p class="comp-label">Techniques :</p>
                <ul class="comp-grid">
                    {% set aucune_competence_tech = true %}
                    {% for competence in competences %}
                    {% if competence.categorie == 'Technique' %}
                        <li><span class="dot blue"></span>{{competence.nom}}</li>
                        {% set aucune_competence_tech = false %}
                    {% endif %}
                    {% endfor %}
                    {% if aucune_competence_tech %}
                        <li>Aucune compétence technique spécifiée pour ce stage.</li>
                    {% endif %}
                </ul>
                </div>

                <div class="comp-section">
                <p class="comp-label">Sociales :</p>
                <ul class="comp-grid">
                    {% set aucune_competence_soc = true %}
                    {% for competence in competences %}
                    {% if competence.categorie == 'Social' %}
                        <li><span class="dot blue"></span>{{competence.nom}}</li>
                        {% set aucune_competence_soc = false %}
                    {% endif %}
                    {% endfor %}
                    {% if aucune_competence_soc %}
                        <li>Aucune compétence sociale spécifiée pour ce stage.</li>
                    {% endif %}
                </ul>
                </div>
          </div>

          <button id="finaliser-candidature-button" class="btn-postuler" type="submit" form="application-form">Finaliser la candidature</button>

        </div>

      </div>
    </main>





{% endblock %}