<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="icon" type="image/png" href="/image/logo_projet_web.png">
    <title>Welcome to the ocean</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Jersey+25&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@100..900&display=swap" rel="stylesheet">

    {% block styles %}{% endblock %}


</head>

<body>
    {% block header%}
    <header>
        <nav>

            <input class="header-burger-input" type="checkbox" id="id_header_burger" tabindex="0">
            <label for="id_header_burger" class="burger"><span></span><span></span><span></span></label>

            <a href="/" class="logo-link" style="display:inline-block;">
                <img src="/image/logo_projet_web.png" alt="Logo" class="header-logo">
            </a>

            <ul class="header-links">

                <li><a href="/">Accueil</a></li>
                <li><a href="/#Stages">Nos Stages</a></li>
                <li><a href="/#Entreprises">Nos Entreprises</a></li>
                <li><a href="/search">Rechercher</a></li>
                
            {% if session.role is defined %}
                {% if session.role == 'admin' %}
                <li><a href="/admin_dashboard">Admin Dashboard</a></li>
                {% elseif session.role == 'etudiant' %}
                <li><a href="/student_dashboard">Student Dashboard</a></li>
                {% elseif session.role == 'pilote' %}
                <li><a href="/pilote_dashboard">Pilote Dashboard</a></li>
                {% elseif session.role == 'entreprise' %}
                <li><a href="/entreprise_dashboard">Entreprise Dashboard</a></li>
                {% endif %}
            {% endif %}

            </ul>

            <div class="account-div">
                {% if session.role is defined %}
                <a href="/logout" class="signup">
                    Se déconnecter
                </a>
                {% else %}
                <a href="/signup" class="signup">
                    S'inscrire
                </a>
                <a href="/signin" class="login">
                    Se connecter
                </a>
                {% endif %}
            </div>
        </nav>
    </header>
{% endblock %}


    {% block content %}{% endblock %}

{% block footer %}
<footer class="footer">
    <div class="ocean">
        <div class="waves">
            <div class="wave" id="wave_1"></div>
            <div class="wave" id="wave_2"></div>
            <div class="wave" id="wave_3"></div>
            <div class="wave" id="wave_4"></div>
            <div class="wave" id="wave_5"></div>
        </div>

        <div class="continuite">
            <div class="footer-content">
                <div class="footer-top-div">
                    <span class="copyright-txt">©2026 BOLT (Bastien, Oan, Louis, Tychique)</span>

                    <div class="log-div">
                        {% if session.role is defined %}
                        <span><a href="/logout">Log out</a></span>
                        {% else %}
                        <span><a href="/signin">Log in</a></span>
                        <span><a href="/signup">Sign up</a></span>
                        {% endif %}
                    </div>

                    <hr>
                </div>
                <div class="footer-bottom-div">
                    <span class="legal-link">
                        <a href="/mentionslegales">Mentions Legales</a>
                    </span>
                    <span class="footer-logo">
                        <img src="/image/logo_projet_web.png" alt="Logo">
                    </span>
                    <div class="speed-link">
                        <div class="quick-links">
                            <span class="title">Liens rapides :</span>
                            <ul>
                                <li><a href="/#Entreprises">Entreprises</a></li>
                                <li><a href="/#Stages">Stages</a></li>
                            </ul>
                            <ul>
                                <li><a href="/search">Rechercher</a></li>
                                <li><a href="/">Accueil</a></li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</footer>
{% endblock %}
</body>

</html>