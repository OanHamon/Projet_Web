{% extends 'base.twig' %}

{% block styles %}
        <link rel="stylesheet" href="/css/token.css">
        <link rel="stylesheet" href="/css/style_entreprise_page.css">

{% endblock %}



{% block content %}
    <main class="content">
        <section>
            <div class="image-banner-entreprise">
                <div class="overlay">
                    <h1>{{entreprise.nom}}</h1>
                    <p>{{entreprise.phrase_intro}}</p>
                </div>  
        </section>
        <section>
            <div class="description-container-entreprise">
                <h2>Decouvrez nous !</h2>
                    <div id="content"></div>

                    <script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>
                    <script>
                    const markdownText = `{{entreprise.description_entreprise}}`;
                    document.getElementById("content").innerHTML = marked.parse(markdownText);
                    </script>
        <section>
            <div class="section-title">
                <h2>Nos flotte de stage</h2>
            </div>
            <div class="carousel-container-entreprise">
                {% for offre in offres %}
                    <div class="card-wrapper" style="position: relative">
                        <article class="stage-card card" >
                            <form method="POST" action="/wishlist/add">
                                <input type="hidden" name="id_offre" value="{{offre.id_offre}}">
                                <button class="icon" style="position: absolute; top: 15px; right: 15px;">+</button>
                            </form>
                            <a href="/offre/{{offre.id_offre}}" class="card-link">
                                <div class="stage-card-header">
                                </div>
                                <div class="stage-card-body">
                                    <h3>{{offre.titre}}</h3>
                                    <p class="company">{{offre.nom}}</p>
                                    <p class="description">
                                        {{offre.description_carte}}
                                    </p>
                                </div>
                            </a>
                        </article>
                    </div>
                {% else %}
                    <p>NO DATA FOUND</p>
                {% endfor %}


                

            </div>
        </section>

        <section class="section-list">
            <h2>Ce qu'on recherche</h2>
            <div class="list-container-entreprise">

                <article class="list-entreprise">
                    <h3>Compétences Techniques</h3>
                    <ul>
                        {% for competence in competences%}
                            {% if competence.categorie == 'Technique' %}
                            <li><span class="dot"></span>{{competence.nom}}</li>
                            {% endif %}
                        {% else %}
                            <p>Nous ne cherchons pas de compétences techniques particulières</p>
                        {% endfor %}
                    </ul>
                    
                </article>
                <article class="list-entreprise">
                    <h3>Compétences Social</h3>
                    <ul>
                        {% for competence in competences%}
                            {% if competence.categorie == 'Social' %}
                            <li><span class="dot"></span>{{competence.nom}}</li>                   
                            {% endif %}
                        {% else %}
                        <p>Nous ne cherchons pas de compétences social particulières</p>
                        {% endfor %}
                    </ul>
                </article>
            </div>
        </section>  
        <section class="section-contact">
            <h2>Contactez Nous</h2>
            <div class="contact-container">
                <span class="email">
                    <h3>Email : </h3>
                    <p>{{entreprise.email}}</p>
                </span>
                <span class="numero">
                    <h3>Numero de telephone : </h3>
                    <p>{{entreprise.telephone}}</p>
                </span>
            </div>

        </section>

        <section class="section-opinion">
            
            <h2>Notations</h2>
            <h3>note de l'entreprise : <span>{{ note }}/5</span></h3>
            <form method="POST" action="/entreprise/{{entreprise.id_entreprise}}/rate">
                <h3>Votre note: {{ note_user }}</h3>
                <div class="star-rating">

                    <input type="radio" id="star5" name="rating" value="5">
                    <label for="star5">★</label>

                    <input type="radio" id="star4" name="rating" value="4">
                    <label for="star4">★</label>

                    <input type="radio" id="star3" name="rating" value="3">
                    <label for="star3">★</label>

                    <input type="radio" id="star2" name="rating" value="2">
                    <label for="star2">★</label>

                    <input type="radio" id="star1" name="rating" value="1" >
                    <label for="star1">★</label>

                </div>
            </form>

        </section>
    </main>
<script>

const entrepriseNote = {{ note_user }};
if(entrepriseNote){
    document.getElementById('star' + entrepriseNote).checked = true;
}
document.querySelectorAll('.star-rating input').forEach(input => {
    input.addEventListener('change', function() {
        this.closest('form').submit();
    });
});


</script>
    {% endblock %}