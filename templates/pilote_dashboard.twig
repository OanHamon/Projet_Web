{% extends 'base.twig' %}


    {% block styles %}
        <link rel="stylesheet" href="/css/token.css">
         <link rel="stylesheet" href="/css/style_compte_pilote_page.css">

    {% endblock %}

{% block content %}
    <main>
        <!-- SECTION COMPTE PILOTE -->
        <section class="hero">
            <h1>Mon Compte Pilote :</h1>
            <p>{{user.prenom}} {{user.nom}}</p>
        </section>

        <section class="modif-block">
            <div class="field-container">

        <div class="account-card dashboard-student-card">
            <h2>Mon Compte</h2>

            <form class="account-form" method="POST" action="/pilote_dashboard/updateinfo" >
                <div class="form-row">
                    <div class="form-group">
                        <label>Prénom</label>
                        <input type="text" name='prenom' placeholder="{{user.prenom}}">
                    </div>

                    <div class="form-group">
                        <label>Nom</label>
                        <input type="text" name="nom" placeholder="{{user.nom}}">
                    </div>

                </div>
                <div class="form-group">
                    <label>Email</label>
                    <input type="text" name="email" placeholder="{{user.email}}">
                </div>
                <br>
                <div class="form-row">
                    <div class="form-group">
                        <label>Mots de passe</label>
                        <input type="text" name="mdp" placeholder="MDP">
                    </div>
                    <div class="form-group">
                        <label>Confirmation</label>
                        <input type="text" name="mdp" placeholder="MDP">
                    </div>


                </div>

                <br>
                <br>

                <button class="btn-primary">Enregistrer</button>
            </form>
        </div>

            </div>

        </section>

        <section class="pilote-section">
            <div class="pere">
                <h2 class="pilote-title"></h2>

                <aside class="columns-container">
                    <div class="offres-header" id="ModifOffre">
                        <h3>Vos Eleves</h3>
                        <a href="/pilote_dashboard?create=true"><div class="add-student">+</div></a>
                    </div>
                    <ul>
                        {% for etudiant in etudiants %}
                        <li class="student-item" style="position: relative">
                            <a href="/pilote_dashboard?etudiant_id={{etudiant.id_etudiant}}">
                                <div class="student-content">
                                    <h4>{{etudiant.nom}} {{etudiant.prenom}}</h4>
                                </div>
                            </a>
                            <form method="POST" action="/pilote_dashboard/delete_student" style="position: absolute; top: 10px; right: 10px;">
                                <input type="hidden" name="id_etudiant" value="{{etudiant.id_etudiant}}">
                                <button type="submit">
                                    <svg id="Trash--Streamline-Atlas" xmlns="http://www.w3.org/2000/svg" viewBox="-0.5 -0.5 16 16" height="16" width="16">
                                        <desc>
                                        Trash Streamline Icon: https://streamlinehq.com
                                        </desc>
                                        <defs></defs>
                                        <path d="M10.549999999999999 14.0625H4.45a1.1875 1.1875 0 0 1 -1.1875 -1.125L2.725 3.325h9.549999999999999l-0.5375 9.6125a1.1875 1.1875 0 0 1 -1.1875 1.125Z" fill="none" stroke="#000000" stroke-miterlimit="10" stroke-width="1"></path>
                                        <path d="m1.53125 3.325 11.9375 0" fill="none" stroke="#000000" stroke-miterlimit="10" stroke-width="1"></path>
                                        <path d="M6.30625 0.9375h2.3874999999999997a1.1937499999999999 1.1937499999999999 0 0 1 1.1937499999999999 1.1937499999999999v1.1937499999999999H5.1125V2.13125a1.1937499999999999 1.1937499999999999 0 0 1 1.1937499999999999 -1.1937499999999999Z" fill="none" stroke="#000000" stroke-miterlimit="10" stroke-width="1"></path>
                                        <path d="m7.5 5.1125 0 7.1625000000000005" fill="none" stroke="#000000" stroke-miterlimit="10" stroke-width="1"></path>
                                        <path d="m9.8875 5.1125 0 7.1625000000000005" fill="none" stroke="#000000" stroke-miterlimit="10" stroke-width="1"></path>
                                        <path d="m5.1125 5.1125 0 7.1625000000000005" fill="none" stroke="#000000" stroke-miterlimit="10" stroke-width="1"></path>
                                    </svg>
                                </button>
                            </form>
                        </li>
                         {% endfor %}
                                                 
                    </ul>
                </aside>

                <div class="student-block-content">
                    {%if create == true %}
                        <h4>Recherchez un eleve</h4>
                    {% elseif etudiantToDisplay %}
                        <h3>Votre Eleve</h3>
                        <p>{{etudiantToDisplay.nom}} {{etudiantToDisplay.prenom}}</p>
                        <p>Nombre d'offre postuler : {{postulations|length }}</p>
                        {% for postulation in postulations %}
                            <a href="/offre/{{postulation.id_offre}}">
                                <div>
                                    <h3>{{postulation.titre}}</h3>
                                </div>

                            </a>
                        {% endfor %}
                    {% endif %}

                    

                </div>
            </div>
        </section>

     <section class="danger-zone">
        <form method="POST" action="/pilote_dashboard/deleteaccount">
            <label><h2>Supprimer le Pilote</h2></label>
            <button class="delete-account-btn">Supprimer le compte Pilote</button>
        </form>

    </section>

    
 

    
    <script>
        // --- Modals ---
        function openModal(id) {
            document.getElementById('modal-' + id).classList.add('active');
        }

        function closeModal(id) {
            const overlay = document.getElementById('modal-' + id);
            overlay.classList.remove('active');

            const content = document.getElementById('content-' + id);
            if (content && content.dataset.confirmed === 'true') {
                setTimeout(() => {
                    content.dataset.confirmed = 'false';
                    content.innerHTML = content.dataset.original;
                }, 300);
            }
        }

        function confirmDelete(id, message) {
            const content = document.getElementById('content-' + id);
            if (!content.dataset.original) {
                content.dataset.original = content.innerHTML;
            }
            content.dataset.confirmed = 'true';
            content.innerHTML = `
                <div class="success-message" style="text-align:center; padding:20px;">
                    <span style="font-size:2rem; display:block; margin-bottom:10px;">✅</span>
                    <strong>${message}</strong>
                </div>
                <div class="btn-group" style="margin-top:20px;">
                    <button class="btn-dark" style="width:100%" onclick="closeModal('${id}')">Fermer</button>
                </div>
            `;
        }

        function selectClass(btn) {
            btn.closest('.class-selector').querySelectorAll('button').forEach(b => b.classList.remove('selected'));
            btn.classList.add('selected');
        }

        document.querySelectorAll('.overlay').forEach(overlay => {
            overlay.addEventListener('click', function(e) {
                if (e.target === this) {
                    const id = this.id.replace('modal-', '');
                    closeModal(id);
                }
            });
        });

  
    </script>

{% endblock %}


