{% extends 'base.twig' %}

{% set contact_email = "contact@projet-web.fr" %}

{% block styles %}
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/css/style_mentions_page.css">
<link rel="stylesheet" href="/css/token.css">
{% endblock %}

{% block content %}
<main class="container">

    <h1 class="ml-title-simple">Mentions légales</h1>

    {# Section Éditeur #}
    <section class="bloc" aria-labelledby="titre-editeur">
        <h2 id="titre-editeur">
            <span class="ml-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
                    <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" />
                    <circle cx="12" cy="7" r="4" />
                </svg>
            </span>
            Éditeur
        </h2>

        <div class="ml-grid">
            <article class="ml-card">
                <span class="ml-lbl">Nom</span>
                <div class="ml-val">Groupe 1 Projet WEB BOLT</div>
            </article>
            <article class="ml-card">
                <span class="ml-lbl">Statut</span>
                <div class="ml-val">Étudiants</div>
            </article>
            <article class="ml-card">
                <span class="ml-lbl">Email</span>
                <div class="ml-val">
                    <a href="mailto:{{ contact_email }}">{{ contact_email }}</a>
                </div>
            </article>
        </div>

        <p class="ml-note">Ce site est un projet fictif réalisé dans le cadre d'un exercice pédagogique.</p>
    </section>

    {# Section Hébergeur #}
    <section class="bloc" aria-labelledby="titre-hebergeur">
        <h2 id="titre-hebergeur">
            <span class="ml-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
                    <rect x="2" y="2" width="20" height="8" rx="2" />
                    <rect x="2" y="14" width="20" height="8" rx="2" />
                    <line x1="6" y1="6" x2="6.01" y2="6" />
                    <line x1="6" y1="18" x2="6.01" y2="18" />
                </svg>
            </span>
            Hébergeur
        </h2>

        <div class="ml-grid">
            <div class="ml-card">
                <span class="ml-lbl">Société</span>
                <div class="ml-val">Microsoft Azure</div>
            </div>
            <div class="ml-card">
                <span class="ml-lbl">Adresse</span>
                <address class="ml-val"> One Microsoft Place, South County Business Park, Leopardstown, Dublin 18, D18
                    P521, Irlande</address>
            </div>
            <div class="ml-card">
                <span class="ml-lbl">Téléphone</span>
                <div class="ml-val">+353 1 295 3826<a href="tel:1007"></a></div>
            </div>
        </div>
    </section>

    {# Section Confidentialité #}
    <section class="bloc-content" id="politique-confidentialite" aria-labelledby="titre-privacy">
        <h2 id="titre-privacy">
            <span class="ml-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
                    <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
                </svg>
            </span>
            Politique de confidentialité
        </h2>

        <div class="ml-content-text">
            <h3>Données collectées</h3>
            <p>Ce site peut collecter via ses formulaires : nom, prénom, email et message.</p>

            <hr class="ml-sep">

            <h3>Finalité et Conservation</h3>
            <p>Les données servent uniquement à répondre à vos messages. Elles sont conservées <strong>12 mois</strong>
                maximum et ne sont jamais transmises à des tiers.</p>

            <hr class="ml-sep">

            <h3>Vos Droits (RGPD)</h3>
            <p>Vous disposez d'un droit d'accès, de rectification et de suppression. Contactez-nous : <a
                    href="mailto:{{ contact_email }}" class="ml-link-accent">{{ contact_email }}</a></p>
        </div>

        <aside class="mention-fictif" role="alert">
            <p>⚠️ <strong>Note importante :</strong> Ce site est un projet fictif. Aucun service réel n'est proposé.</p>
        </aside>
    </section>

</main>
{% endblock %}