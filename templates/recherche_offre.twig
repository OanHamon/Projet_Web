{% extends 'base.twig' %}

{% block styles %}
    <link rel="stylesheet" href="/css/token.css">
    <link rel="stylesheet" href="/css/style_search_page.css">

    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
            integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY="
            crossorigin=""
    />
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"
        integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo="
        crossorigin="">
    </script>
{% endblock %}

{% block content %}
    
    <main class="content-search-page">

        <form method="GET" action="/search" class="stage-search-box card">
    
            <div class="search-box-label-bar">
                <label class="search-ocean-catchphrase">Plongez dans l'océan des opportunités</label>
                <div class="search-container">
                    <input type="search" name="key_words[]" placeholder="Recherchez dans l'océan des stages" aria-label="Rechercher un stage">
                    <button type="submit" aria-label="Lancer la recherche">
                        <img src="data:image/png;base64," alt="icon" />
                    </button>
                </div>
            </div>
        
            <div class="tag-box">
                {% for kw in selected_keywords %}
                    {% if kw is not empty %}
                    <div class="tag">
                        <p>{{ kw }}</p>
                        <input type="hidden" name="key_words[]" value="{{ kw }}">
                        <button type="button" onclick="
                            this.closest('.tag').querySelector('input').disabled = true;
                            this.closest('form').submit();
                            this.closest('.tag').remove();
                        ">X</button>
                    </div>
                    {% endif %}
                {% endfor %}
            </div>
        
            <div class="carte">
                <div class="distance-slider-container">
                    <label for="slider-distance">Distance (km)</label>
                    <div class="distance-slider-form">
                        <input type="range" id="slider-distance"
                            min="1" max="100" value="{{ dist|default(50) }}"
                            oninput="document.getElementById('distance-value').innerText = this.value + ' km';">
                        <span id="distance-value">{{ dist|default(50) }} km</span>
                    </div>
                </div>
                <div id="map"></div>
        
                <input type="hidden" id="lat" name="lat" value="{{ lat|default(0) }}">
                <input type="hidden" id="lng" name="lng" value="{{ lng|default(0) }}">
                
                <button type="submit" class="btn-submit-all">OK</button>
            </div>
        </form>

        <div class="search-stage-result-box">
            <h2>
                {% if offres|length >= 100 %}
                    100 offres ou plus trouvées
                {% else %}
                    {{ offres|length }} offres trouvées
                {% endif %}
            </h2>
            {% for offre in offres %}
                <a href="/offre/{{ offre.id_offre }}" class="card-stage">
                    <div class="card-stage-header">
                        {{ offre.titre }}
                    </div>
                    <div class="card-stage-content">
                        <div class="card-stage-entreprise">
                            {{ offre.entreprise_nom }}
                        </div>
                        <div class="card-stage-description">
                            <div class="dates-offre">
                                <span>
                                    {% if offre.date_debut %}
                                        Du {{ offre.date_debut|date("d/m/Y") }}
                                    {% endif %}
                                </span>
                                <span>
                                    {% if offre.date_fin %}
                                        au {{ offre.date_fin|date("d/m/Y") }}
                                    {% endif %}
                                </span>
                            </div>
                            <p class="texte-description-card-stage">
                                {{ offre.description_carte }}
                            </p>
                            {% if dist is not null and dist != '' %}
                                <small>{{ offre.distance|round(1) }} km</small>
                            {% endif %}
                        </div>
                    </div>
                </a>
            {% else %}
                <p>Aucune offre trouvée pour ces critères.</p>
        {% endfor %}
        </div>
    </main>
        <script src="/scripts/map.js"></script>
{% endblock %}